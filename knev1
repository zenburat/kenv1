local lockLbl = New("TextLabel", {
    Text = "● LOCKED", Font = Enum.Font.GothamBold, TextSize = 13,
    TextColor3 = THEME.Text, BackgroundTransparency = 1, ZIndex = 2,
    Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center,
})
lockLbl.Parent = lockChip

local function AttachDiedWatcher(p)
    if silentDiedConn then silentDiedConn:Disconnect() end
    local char = p.Character; if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid"); if not hum then return end
    silentDiedConn = hum.Died:Connect(function()
        task.wait(0.2)
        local nxt = GetClosest(p)
        silentTarget = nxt
        if nxt then
            lockLbl.Text = "● LOCKED: " .. nxt.DisplayName
            AttachDiedWatcher(nxt)
        else
            lockChip.Visible = false
        end
    end)
end

Settings:Connect("SilentAim", function(on)
    if on then
        local t = GetClosest()
        silentTarget = t
        if t then
            lockLbl.Text = "● LOCKED: " .. t.DisplayName
            lockChip.Visible = true
            AttachDiedWatcher(t)
        end
    else
        silentTarget = nil
        lockChip.Visible = false
        if silentDiedConn then silentDiedConn:Disconnect() end
    end
end)

RunService.RenderStepped:Connect(function()
    if not Settings:Get("SilentAim") then return end
    if not silentTarget then
        local nxt = GetClosest()
        if nxt then
            silentTarget = nxt
            lockLbl.Text = "● LOCKED: " .. nxt.DisplayName
            lockChip.Visible = true
            AttachDiedWatcher(nxt)
        end
        return
    end

    local char = silentTarget.Character
    local head = char and char:FindFirstChild("Head")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not head or not hum or hum.Health <= 0 then return end

    local targetCF = CFrame.new(camera.CFrame.Position, head.Position)
    camera.CFrame = camera.CFrame:Lerp(targetCF, 0.28)
end)

