local Settings = { Values = {}, Listeners = {} }
function Settings:Set(id, val)
    self.Values[id] = val
    for _, fn in ipairs(self.Listeners[id] or {}) do task.spawn(fn, val) end
end
function Settings:Get(id) return self.Values[id] end
function Settings:Connect(id, fn)
    self.Listeners[id] = self.Listeners[id] or {}
    table.insert(self.Listeners[id], fn)
    fn(self.Values[id])
end

