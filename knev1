local espData = {}
local SKELETON_BONES = {
    { "Head", "UpperTorso" }, { "UpperTorso", "LowerTorso" },
    { "UpperTorso", "LeftUpperArm" }, { "LeftUpperArm", "LeftLowerArm" }, { "LeftLowerArm", "LeftHand" },
    { "UpperTorso", "RightUpperArm" }, { "RightUpperArm", "RightLowerArm" }, { "RightLowerArm", "RightHand" },
    { "LowerTorso", "LeftUpperLeg" }, { "LeftUpperLeg", "LeftLowerLeg" }, { "LeftLowerLeg", "LeftFoot" },
    { "LowerTorso", "RightUpperLeg" }, { "RightUpperLeg", "RightLowerLeg" }, { "RightLowerLeg", "RightFoot" },
}

local function GetESPData(p)
    if not espData[p] then
        local data = { lines = {} }
        local hl = Instance.new("Highlight")
        hl.Name = HL_NAME
        hl.FillColor = Color3.fromRGB(255, 255, 255)
        hl.OutlineColor = Color3.fromRGB(0, 0, 0)
        hl.FillTransparency = 0.6
        hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = gui
        data.highlight = hl

        data.hp = Drawing.new("Text")
        data.hp.Size = 13; data.hp.Color = Color3.fromRGB(255,255,255); data.hp.Outline = true; data.hp.Center = true
        data.dist = Drawing.new("Text")
        data.dist.Size = 13; data.dist.Color = Color3.fromRGB(200,200,200); data.dist.Outline = true; data.dist.Center = true
        data.name = Drawing.new("Text")
        data.name.Size = 13; data.name.Color = Color3.fromRGB(255,255,255); data.name.Outline = true; data.name.Center = true
        for i = 1, #SKELETON_BONES do
            local ln = Drawing.new("Line")
            ln.Thickness = 1.5; ln.Color = Color3.fromRGB(255,255,255); ln.Transparency = 0.9
            data.lines[i] = ln
        end
        espData[p] = data
    end
    return espData[p]
end

Players.PlayerRemoving:Connect(function(p)
    if espData[p] then
        if espData[p].highlight then espData[p].highlight:Destroy() end
        for _, ln in ipairs(espData[p].lines) do ln:Remove() end
        espData[p].hp:Remove(); espData[p].dist:Remove(); espData[p].name:Remove()
        espData[p] = nil
    end
end)

RunService.RenderStepped:Connect(function()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == player then continue end
        local data = GetESPData(p)
        local char = p.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")
        local hide = not Settings:Get("ESP") or not char or not hum or not root or not head
            or hum.Health <= 0
            or (Settings:Get("TeamCheck") and p.Team == player.Team and p.Team ~= nil)
        if hide then
            data.highlight.Adornee = nil
            data.hp.Visible = false; data.dist.Visible = false; data.name.Visible = false
            for _, ln in ipairs(data.lines) do ln.Visible = false end
            continue
        end
        data.highlight.Adornee = char
        local visible = HasLOS(camera.CFrame.Position, root.Position)
        data.highlight.FillColor = visible and Color3.fromRGB(255,255,255) or Color3.fromRGB(120,120,120)
        data.highlight.OutlineColor = visible and Color3.fromRGB(0,0,0) or Color3.fromRGB(60,60,60)
        for i, bones in ipairs(SKELETON_BONES) do
            local a = char:FindFirstChild(bones[1]); local b = char:FindFirstChild(bones[2])
            local ln = data.lines[i]
            if a and b then
                local aScr, aOn = camera:WorldToViewportPoint(a.Position)
                local bScr, bOn = camera:WorldToViewportPoint(b.Position)
                if aOn and bOn then
                    ln.Visible = true
                    ln.From = Vector2.new(aScr.X, aScr.Y); ln.To = Vector2.new(bScr.X, bScr.Y)
                    ln.Color = visible and Color3.fromRGB(255,255,255) or Color3.fromRGB(150,150,150)
                else ln.Visible = false end
            else ln.Visible = false end
        end
        local headScr, onScreen = camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.5, 0))
        if not onScreen then
            data.name.Visible = false; data.hp.Visible = false; data.dist.Visible = false
            continue
        end
        local screenPos = Vector2.new(headScr.X, headScr.Y)
        local distStuds = (camera.CFrame.Position - root.Position).Magnitude
        data.name.Visible = true; data.name.Text = p.DisplayName
        data.name.Position = screenPos + Vector2.new(0, -28)
        data.name.Color = visible and Color3.fromRGB(255,255,255) or Color3.fromRGB(180,180,180)
        data.hp.Visible = true; data.hp.Text = math.floor(hum.Health) .. " HP"
        data.hp.Position = screenPos + Vector2.new(0, 14); data.hp.Color = Color3.fromRGB(255,255,255)
        data.dist.Visible = true; data.dist.Text = string.format("[%d studs]", math.floor(distStuds))
        data.dist.Position = screenPos + Vector2.new(0, 28); data.dist.Color = Color3.fromRGB(200,200,200)
    end
end)

