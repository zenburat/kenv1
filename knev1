-- NO RECOIL
--------------------------------------------------------------------
local lastPitch = 0
RunService.RenderStepped:Connect(function()
    local _, pitch, _ = camera.CFrame:ToOrientation()
    if not Settings:Get("NoRecoil") then
        lastPitch = pitch; return
    end
    local drift = pitch - lastPitch
    if drift > 0.0005 then
        camera.CFrame = camera.CFrame * CFrame.Angles(-drift * 0.97, 0, 0)
    end
    lastPitch = select(2, camera.CFrame:ToOrientation())
end)

--------------------------------------------------------------------
-- GOD MODE  (SAFE)
--------------------------------------------------------------------
local godEnabled = false
local godConns   = {}
local godLoop    = nil

local function SafeMaxHealth(hum) return hum.MaxHealth > 100 and hum.MaxHealth or 100 end
local function SafeHeal(hum)
    pcall(function()
        if hum and hum.Parent and hum.Health > 0 then
            local max = SafeMaxHealth(hum)
            if hum.Health < max then hum.Health = max end
        end
    end)
end

local function StartGodLoop()
    if godLoop then godLoop:Disconnect(); godLoop = nil end
    godLoop = RunService.Heartbeat:Connect(function()
        if not godEnabled then return end
        local char = player.Character; if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid"); if not hum then return end
        pcall(function()
            hum.BreakJointsOnDeath = false
            local max = SafeMaxHealth(hum)
            if hum.Health < max then hum.Health = max end
        end)
    end)
end

local function InstallCharGod(char)
    for _, c in ipairs(godConns) do pcall(function() c:Disconnect() end) end
    godConns = {}
    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end
    pcall(function() hum.BreakJointsOnDeath = false end)
    table.insert(godConns, hum.HealthChanged:Connect(function() if godEnabled then SafeHeal(hum) end end))
    table.insert(godConns, hum:GetPropertyChangedSignal("Health"):Connect(function() if godEnabled then SafeHeal(hum) end end))
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        table.insert(godConns, root.Touched:Connect(function(hit)
            if not godEnabled then return end
            pcall(function()
                local n = hit.Name:lower()
                if hit:GetAttribute("KillBrick") or n:find("kill") or n:find("lava") or n:find("damage") then
                    SafeHeal(hum)
                end
            end)
        end))
    end
end

Settings:Connect("GodMode", function(on)
    godEnabled = on
    if on then
        StartGodLoop()
        if player.Character then InstallCharGod(player.Character) end
    else
        if godLoop then godLoop:Disconnect(); godLoop = nil end
        for _, c in ipairs(godConns) do pcall(function() c:Disconnect() end) end
        godConns = {}
    end
end)

player.CharacterAdded:Connect(function(char)
    task.wait(0.3)
    if godEnabled then InstallCharGod(char) end
end)

