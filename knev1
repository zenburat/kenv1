local function BuildToggle(feature, order)
    local state = feature.default
    local row = New("TextButton", {
        Text = "", AutoButtonColor = false, LayoutOrder = order,
        Size = UDim2.new(1, -6, 0, 54), BackgroundColor3 = THEME.Row,
        BorderSizePixel = 0,
    }, { Corner(16), Stroke(THEME.Stroke, 1) })

    New("TextLabel", {
        Text = feature.name, Font = Enum.Font.GothamMedium, TextSize = 16,
        TextColor3 = THEME.Text, BackgroundTransparency = 1, ZIndex = 2,
        Position = UDim2.fromOffset(16, 7), Size = UDim2.new(0.55, 0, 0, 20),
        TextXAlignment = Enum.TextXAlignment.Left,
    }).Parent = row
    New("TextLabel", {
        Text = feature.desc, Font = Enum.Font.Gotham, TextSize = 11,
        TextColor3 = THEME.SubText, BackgroundTransparency = 1, ZIndex = 2,
        Position = UDim2.fromOffset(16, 28), Size = UDim2.new(0.55, 0, 0, 16),
        TextXAlignment = Enum.TextXAlignment.Left,
    }).Parent = row

    local sLbl = New("TextLabel", {
        Text = "OFF", Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = THEME.SubText,
        BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), ZIndex = 2,
        Position = UDim2.new(1, -76, 0.5, 0), Size = UDim2.fromOffset(40, 20),
        TextXAlignment = Enum.TextXAlignment.Right,
    })
    sLbl.Parent = row

    local track = New("Frame", {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0),
        Size = UDim2.fromOffset(52, 28), BackgroundColor3 = THEME.Off, ZIndex = 2,
        BorderSizePixel = 0,
    }, { Corner(14) })
    local trackGrad = GRAD(THEME.Off, THEME.Off)
    trackGrad.Parent = track

    local knob = New("Frame", {
        AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromOffset(3, 14),
        Size = UDim2.fromOffset(22, 22), BackgroundColor3 = THEME.Knob, ZIndex = 3,
        BorderSizePixel = 0,
    }, { Corner(11), Stroke(THEME.Text, 1) })
    knob.Parent = track; track.Parent = row

    local function Render(anim)
        local t = anim and 0.25 or 0
        Tween(track, t, { BackgroundColor3 = state and THEME.On or THEME.Off })
        trackGrad.Color = state and ColorSequence.new(Color3.fromRGB(255,255,255), Color3.fromRGB(160,160,160))
            or ColorSequence.new(THEME.Off, THEME.Off)
        Tween(knob, t, { Position = state and UDim2.fromOffset(27, 14) or UDim2.fromOffset(3, 14) }, Enum.EasingStyle.Back)
        sLbl.Text = state and "ON" or "OFF"
        Tween(sLbl, t, { TextColor3 = state and THEME.Text or THEME.SubText })
    end

    row.MouseButton1Click:Connect(function()
        state = not state; Render(true); Settings:Set(feature.id, state)
    end)
    row.MouseEnter:Connect(function() Tween(row, 0.15, { BackgroundColor3 = Color3.fromRGB(35, 35, 35) }) end)
    row.MouseLeave:Connect(function() Tween(row, 0.15, { BackgroundColor3 = THEME.Row }) end)
    Render(false)
    row.Parent = fList

    Settings:Connect(feature.id, function(v)
        if v ~= state then state = v; Render(true) end
    end)
end

